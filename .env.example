# Copy the variable names into hPanel -> Node.js app -> Environment variables.
# Never commit real values. After changing any of them, run a new build.

# MySQL database (hPanel -> Databases -> MySQL). Tables `leads` and `offers` are created automatically.
# Use 127.0.0.1, not localhost (localhost can resolve to IPv6, which the DB user may not be allowed on).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Email for new form submissions (the book@landovgold.com mailbox).
# Hostinger email: smtp.hostinger.com, port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=book@landovgold.com
SMTP_PASSWORD=
LEADS_EMAIL=book@landovgold.com

# Admin panel at /admin. At least 8 characters; the panel stays locked while this is empty.
# Changing it logs everyone out.
ADMIN_PASSWORD=

# The owner's personal email: where admin password-reset links go (not the shared bookings inbox).
# Used once password reset is added to the admin panel.
ADMIN_EMAIL=

# Password for the weekly emailed backup archive (it holds customer names and phones).
# Used once automatic backups are added to the admin panel.
BACKUP_PASSWORD=

# Folder for photos uploaded from the admin panel. Must be outside the app folder so a new
# deploy doesn't delete them. Empty = a "landovgold-uploads" folder next to the app folder.
UPLOAD_DIR=
