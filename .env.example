# Copy the variable names into hPanel -> Node.js app -> Environment variables.
# Never commit real values.

# MySQL database (hPanel -> Databases -> MySQL). Form submissions are saved in the `leads` table (created automatically).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Email for new form submissions (the book@landovgold.com mailbox).
# Hostinger email: smtp.hostinger.com, port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=book@landovgold.com
SMTP_PASSWORD=
LEADS_EMAIL=book@landovgold.com
